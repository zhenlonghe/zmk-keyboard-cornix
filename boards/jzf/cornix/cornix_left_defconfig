# e73 config

CONFIG_ADC_NRFX_SAADC=y

# Enable MPU
CONFIG_ARM_MPU=y

CONFIG_PINCTRL=y

# enable GPIO
CONFIG_GPIO=y

CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

CONFIG_MPU_ALLOW_FLASH_WRITE=y

CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y

CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

CONFIG_CLOCK_CONTROL_NRF=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y
# The RC LFCLK drifts with die temperature. Stock calibration runs every 4 s
# and may skip once if the temperature looks stable (~8 s worst case between
# calibrations). Calibrate every 1 s unconditionally to shrink the drift
# window that causes missed connection-event anchors; costs ~5-10 uA.
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC_CALIBRATION=y
CONFIG_CLOCK_CONTROL_NRF_CALIBRATION_PERIOD=1000
CONFIG_CLOCK_CONTROL_NRF_CALIBRATION_MAX_SKIP=0

# e73 config end

CONFIG_ZMK_KEYBOARD_NAME="Cornix"
CONFIG_ZMK_USB=y
CONFIG_ZMK_SPLIT=y
CONFIG_ZMK_SPLIT_ROLE_CENTRAL=y
# Allow brief radio scheduling stalls without delaying genuine link-loss detection too much.
CONFIG_ZMK_SPLIT_BLE_PREF_TIMEOUT=200

# 增加键盘的 BLE 无线电的发射功率，用解决延迟和左右通讯不佳的问题
CONFIG_BT_CTLR_TX_PWR_PLUS_8=y
CONFIG_ZMK_BLE_EXPERIMENTAL_CONN=y

# Tighten BLE sync to fix typing stutter. Both halves run on RC-only LFCLK
# (no 32k crystal), so clock drift accumulates between connection events; at
# the default latency of 30 a link coasts ~232 ms between forced sync points,
# long enough to miss anchors and trigger retransmit chains felt as lag.
# Latency 0 forces a sync every 7.5 ms — DIAGNOSTIC setting: it costs the
# right half ~0.7 mA extra while connected-idle (roughly 5x idle draw). If
# stutter is gone after a few days, settle at 5 (~130 uA, near-free); if
# stutter persists, the problem is the host link / RF environment, not split
# sync — revert to 10 and pursue USB or the dongle setup instead.
CONFIG_ZMK_SPLIT_BLE_PREF_LATENCY=0
CONFIG_BT_PERIPHERAL_PREF_LATENCY=10
# 更改键盘默认显示名称

# 电池电量报告间隔由 cornix_indicator.conf 的 CONFIG_ZMK_BATTERY_REPORT_INTERVAL 决定

CONFIG_PINCTRL=y

# RGB
CONFIG_SPI=n

CONFIG_EC11=y
CONFIG_EC11_TRIGGER_GLOBAL_THREAD=y

# enable display drivers
CONFIG_ZMK_DISPLAY=n

#BLE-passkey
CONFIG_ZMK_BLE_PASSKEY_ENTRY=n

#BLE-clean
CONFIG_ZMK_BLE_CLEAR_BONDS_ON_START=n

CONFIG_ZMK_HID_REPORT_TYPE_NKRO=n


# 5 host profiles + 1 split peripheral
CONFIG_BT_MAX_CONN=6
CONFIG_BT_MAX_PAIRED=6

CONFIG_ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY=y
CONFIG_ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_FETCHING=y

# Enter deep sleep after 20 minutes of whole-keyboard inactivity.
CONFIG_ZMK_SLEEP=y
CONFIG_ZMK_IDLE_SLEEP_TIMEOUT=1200000

# Disable ZMK Studio.
CONFIG_ZMK_STUDIO=n
