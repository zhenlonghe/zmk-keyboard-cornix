CONFIG_ADC_NRFX_SAADC=y

# Enable MPU
CONFIG_ARM_MPU=y

# Use pinctrl
CONFIG_PINCTRL=y

# enable GPIO
CONFIG_GPIO=y

CONFIG_USE_DT_CODE_PARTITION=y
CONFIG_BUILD_OUTPUT_UF2=y

CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y
CONFIG_CLOCK_CONTROL_NRF=y
CONFIG_CLOCK_CONTROL_NRF_K32SRC_RC=y

CONFIG_ZMK_SPLIT=y

CONFIG_ZMK_BLE=y

# Match the central's +8 dBm. The split link is bidirectional: at 0 dBm the
# peripheral->central direction was 8 dB weaker than the reverse, so it was the
# first to break down once the halves were spaced further apart.
CONFIG_BT_CTLR_TX_PWR_PLUS_8=y

# Force the split link onto 1M PHY. 2M buys nothing for a few bytes of key
# position data and costs ~3 dB of receiver sensitivity; disabling it on the
# peripheral makes the pair negotiate 1M while the central keeps 2M for its
# host connection.
CONFIG_BT_CTLR_PHY_2M=n

# never output usb
CONFIG_ZMK_USB=n

CONFIG_INPUT=y

# Enter deep sleep after 20 minutes, matching the central: once it sleeps the
# split link drops and a longer timeout only buys idle advertising.
CONFIG_ZMK_SLEEP=y
CONFIG_ZMK_IDLE_SLEEP_TIMEOUT=1200000

# RGB
#CONFIG_SPI=n
#CONFIG_ZMK_EXT_POWER=n

CONFIG_EC11=y
CONFIG_EC11_TRIGGER_GLOBAL_THREAD=y

# vim: set ft=kconfig:
